{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dakhni.org page",
  "description": "Content file schema for dakhni.org static site pages.",
  "type": "object",
  "required": ["title", "description", "url", "section", "dedication"],
  "properties": {
    "page_type": {
      "type": "string",
      "enum": ["home", "section_hub", "city_leaf", "saint_leaf", "institution_leaf", "heritage_leaf", "dynasty_leaf", "language_leaf", "sacred_site_leaf", "general_leaf"]
    },
    "title": {"type": "string"},
    "description": {"type": "string"},
    "url": {"type": "string", "pattern": "^/(.*/)?$"},
    "section": {"type": "string"},
    "dedication": {"type": "string"},
    "sort_order": {"type": "integer"},
    "eyebrow": {"type": "string"},
    "title_html": {"type": "string"},
    "subtitle": {"type": "string"},
    "urdu": {"type": "string"},
    "cover": {"type": "string"},
    "hero_html": {"type": "string"},
    "level": {"type": "string"},
    "extra_scripts": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "body_html": {"type": "string"},
    "crumb_html": {"type": "string"},
    "subnav_html": {"type": "string"},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"type": "string", "enum": ["html", "intro", "section", "cards", "facts", "timeline"]},
          "html": {"type": "string"},
          "title": {"type": "string"},
          "eyebrow": {"type": "string"},
          "items": {"type": "array"}
        }
      }
    },
    "references": {
      "type": "array",
      "description": "Bibliography for this page. Every id must be cited at least once in the content, either via a <cite data-ref=\"id\"></cite> marker inside an html/section/timeline block, or via a facts item's 'ref' field.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "url": {"type": "string"}
        }
      }
    },
    "link_terms": {
      "type": "array",
      "description": "Exact-phrase names for this page (its title and natural variants). Any of these phrases found as plain text on another page is auto-linked to this page's url, once per page.",
      "items": {"type": "string"}
    },
    "no_subnav": {
      "type": "boolean",
      "description": "If true, this page is excluded from the auto Prev/Next subnav entirely: it gets no subnav of its own, and it is never listed as a sibling in its parent's subnav group. For sub-topic leaf pages that share a URL prefix with unrelated sibling pages but shouldn't join their Prev/Next tour."
    }
  },
  "additionalProperties": false
}
