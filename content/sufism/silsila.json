      "type": "html",
      "html": "<style>\n/* ══════════ Silsila tree — scoped st- namespace ══════════ */\n.st-app{\n  /* surfaces */\n  --st-panel:#FCFAF4;\n  --st-card:#FDFBF5;\n  --st-card-alt:#F6F3E8;\n  --st-deep:#1A1814;\n  --st-shadow:rgba(26,24,20,.08);\n  --st-ctrl:rgba(253,251,245,.94);\n  --st-onc:#FAF7EF;          /* text sitting on a filled branch colour */\n  --st-saint-a:#FBF3DE;\n  --st-saint-b:#F3E5C0;\n  --st-saint-ink:#5C4A22;\n  /* branch colours */\n  --st-qadiri:#7B3030;\n  --st-suhrawardi:#2E5A66;\n  --st-chishti:#3F5D3B;\n  --st-hamadani:#46617A;\n  --st-naqshbandi:#5C3A6B;\n  margin:1.6rem 0 0;\n}\n@media (prefers-color-scheme:dark){\n  .st-app{\n    --st-panel:#1A1712;\n    --st-card:#211D16;\n    --st-card-alt:#1B1812;\n    --st-deep:#0C0A07;\n    --st-shadow:rgba(0,0,0,.55);\n    --st-ctrl:rgba(33,29,22,.94);\n    --st-onc:#14120E;\n    --st-saint-a:#332B1A;\n    --st-saint-b:#282111;\n    --st-saint-ink:#E3CE9C;\n    --st-qadiri:#CE8686;\n    --st-suhrawardi:#82B8C6;\n    --st-chishti:#96C48D;\n    --st-hamadani:#9DB9D1;\n    --st-naqshbandi:#C59DD4;\n  }\n}\n\n/* ── filter / key rail above the frame ── */\n.st-rail{display:flex;flex-wrap:wrap;align-items:center;gap:.4rem;margin-bottom:.7rem}\n.st-rail-lab{font-family:'Inter',sans-serif;font-size:.55rem;font-weight:500;letter-spacing:.26em;text-transform:uppercase;color:var(--ink-faint);margin-right:.3rem}\n.st-f{display:inline-flex;align-items:center;gap:.42rem;font-family:'Inter',sans-serif;font-size:.6rem;font-weight:500;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-soft);background:var(--st-card);border:1px solid var(--rule);border-radius:99px;padding:.42rem .82rem;cursor:pointer;transition:color .18s,border-color .18s,background .18s}\n.st-f:hover{color:var(--gold-deep);border-color:var(--gold)}\n.st-f i{width:9px;height:9px;border-radius:50%;background:var(--c,var(--ink-faint));flex:none;font-style:normal}\n.st-f[aria-pressed=\"true\"]{color:var(--ink);border-color:var(--c,var(--gold));box-shadow:inset 0 0 0 1px var(--c,var(--gold))}\n.st-f[aria-pressed=\"true\"] i{box-shadow:0 0 0 3px color-mix(in srgb,var(--c,var(--gold)) 22%,transparent)}\n\n/* ── the frame ── */\n.st-frame{position:relative;background:var(--st-panel);border:1px solid var(--rule);border-radius:16px;overflow:hidden;box-shadow:0 1px 3px var(--st-shadow);height:clamp(430px,74vh,840px);display:flex}\n.st-viewport{flex:1;min-width:0;overflow:auto;cursor:grab;overscroll-behavior:contain;-webkit-overflow-scrolling:touch;scrollbar-width:thin}\n.st-viewport:focus-visible{outline:2px solid var(--gold);outline-offset:-2px}\n.st-viewport.is-grabbing{cursor:grabbing}\n.st-canvas{position:relative;margin:0 auto}\n/* the padding keeps the first and last rows clear of the floating controls */\n.st-tree{position:absolute;top:0;left:0;transform-origin:0 0;padding:2.4rem 2rem 3.8rem;width:max-content}\n\n/* ── floating controls, inside the chart area ── */\n.st-ctl{position:absolute;z-index:6;display:flex;gap:.15rem;align-items:center}\n.st-ctl-tl{top:.75rem;left:.75rem}\n.st-ctl-br{right:.75rem;bottom:.75rem;background:var(--st-ctrl);border:1px solid var(--rule);border-radius:99px;padding:.28rem;-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);box-shadow:0 2px 10px var(--st-shadow)}\n.st-sq{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;font-family:'Inter',sans-serif;font-size:.95rem;line-height:1;color:var(--ink-soft);background:transparent;border:0;border-radius:99px;cursor:pointer;transition:background .16s,color .16s}\n.st-sq:hover{background:var(--cream);color:var(--gold-deep)}\n.st-sq:focus-visible{outline:2px solid var(--gold);outline-offset:1px}\n.st-sq-txt{width:auto;padding:0 .7rem;font-size:.56rem;font-weight:500;letter-spacing:.15em;text-transform:uppercase}\n.st-sep{width:1px;height:18px;background:var(--rule);margin:0 .22rem;flex:none}\n.st-zlab{min-width:3.1rem;text-align:center;font-family:'Inter',sans-serif;font-size:.58rem;font-weight:500;letter-spacing:.1em;color:var(--ink-faint);-webkit-user-select:none;user-select:none}\n.st-pill{display:inline-flex;align-items:center;gap:.45rem;font-family:'Inter',sans-serif;font-size:.58rem;font-weight:500;letter-spacing:.15em;text-transform:uppercase;color:var(--gold-deep);background:var(--st-ctrl);border:1px solid var(--gold);border-radius:99px;padding:.5rem 1rem;cursor:pointer;box-shadow:0 2px 10px var(--st-shadow);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);transition:background .16s}\n.st-pill:hover{background:var(--cream)}\n.st-pill:focus-visible{outline:2px solid var(--gold);outline-offset:1px}\n\n/* ── full screen ── */\n.st-app.is-full{position:fixed;inset:0;z-index:500;margin:0;padding:.7rem;background:var(--ivory);display:flex;flex-direction:column;gap:.55rem}\n.st-app.is-full .st-rail{margin:0}\n.st-app.is-full .st-frame{flex:1;height:auto;min-height:0;border-radius:12px}\n.st-app.is-full .st-key{display:none}\n.st-app.is-full .st-hint{margin:0}\nbody.st-locked{overflow:hidden}\n\n/* ── org-chart connector geometry ──\n   line style travels in --ls so that the dashed variant never resurrects a\n   border that first-child / last-child suppression has already removed. */\n.st-tree ul{display:flex;justify-content:center;list-style:none;margin:0;padding:1.5rem 0 0;position:relative}\n.st-tree li{display:flex;flex-direction:column;align-items:center;position:relative;padding:1.5rem .4rem 0;--lc:rgba(107,71,16,.34);--ls:solid}\n.st-tree li.st-dash{--ls:dashed}\n.st-tree li::before,.st-tree li::after{content:'';position:absolute;top:0;right:50%;width:50%;height:1.5rem;border-top:1.5px var(--ls) var(--lc)}\n.st-tree li::after{right:auto;left:50%;border-left:1.5px var(--ls) var(--lc)}\n.st-tree li:only-child{padding-top:0}\n.st-tree li:only-child::before,.st-tree li:only-child::after{display:none}\n.st-tree li:first-child::before,.st-tree li:last-child::after{border-top-width:0}\n.st-tree li:last-child::before{border-right:1.5px var(--ls) var(--lc);border-radius:0 8px 0 0}\n.st-tree li:first-child::after{border-radius:8px 0 0 0}\n.st-tree ul ul::before{content:'';position:absolute;top:0;left:50%;width:0;height:1.5rem;border-left:1.5px solid var(--lc)}\n.st-tree ul.st-dashkids::before{border-left-style:dashed}\n.st-tree>ul,.st-tree>ul>li{padding-top:0}\n.st-tree>ul>li::before,.st-tree>ul>li::after{display:none}\n@media (prefers-color-scheme:dark){.st-tree li{--lc:rgba(224,179,107,.34)}}\n\n/* branch colours */\n.st-b-qadiri{--oc:var(--st-qadiri)}\n.st-b-suhrawardi{--oc:var(--st-suhrawardi)}\n.st-b-chishti{--oc:var(--st-chishti)}\n.st-b-hamadani{--oc:var(--st-hamadani)}\n.st-b-naqshbandi{--oc:var(--st-naqshbandi)}\n.st-b-root{--oc:var(--gold-deep)}\n.st-tree li.st-b-qadiri{--lc:color-mix(in srgb,var(--st-qadiri) 55%,transparent)}\n.st-tree li.st-b-suhrawardi{--lc:color-mix(in srgb,var(--st-suhrawardi) 55%,transparent)}\n.st-tree li.st-b-chishti{--lc:color-mix(in srgb,var(--st-chishti) 55%,transparent)}\n.st-tree li.st-b-hamadani{--lc:color-mix(in srgb,var(--st-hamadani) 55%,transparent)}\n.st-tree li.st-b-naqshbandi{--lc:color-mix(in srgb,var(--st-naqshbandi) 55%,transparent)}\n.st-tree li.st-b-root{--lc:color-mix(in srgb,var(--gold) 60%,transparent)}\n\n/* ── cross-links: a second documented thread between two cards that the\n      single-parent tree cannot express by nesting ── */\n.st-xlink{position:absolute;left:0;top:0;overflow:visible;pointer-events:none}\n.st-xlink path{fill:none;stroke:var(--st-qadiri);stroke-width:1.5;stroke-dasharray:5 4}\n.st-xlink text{font-family:'Inter',sans-serif;font-size:8px;letter-spacing:.12em;text-transform:uppercase;fill:var(--st-qadiri)}\n\n/* ── node cards ── */\n.st-cardwrap{position:relative;z-index:1}\n.st-node{display:block;position:relative;background:var(--st-card);border:1px solid var(--rule);border-top:3px solid var(--oc,var(--ink-faint));border-radius:10px;width:186px;padding:.85rem .85rem .8rem;text-align:center;box-shadow:0 1px 3px var(--st-shadow);color:inherit;text-decoration:none;text-wrap:balance;overflow-wrap:break-word;hyphens:none}\n.st-chip{display:inline-block;font-family:'Inter',sans-serif;font-size:.5rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--st-onc);background:var(--oc,var(--ink-faint));padding:.18rem .55rem;border-radius:99px;margin-bottom:.5rem}\n.st-name{font-family:'Cormorant Garamond',serif;font-size:1.05rem;font-weight:600;line-height:1.25;color:var(--ink);margin:0}\n.st-sub{font-family:'EB Garamond',serif;font-style:italic;font-size:.76rem;line-height:1.4;color:var(--ink-faint);margin:.28rem 0 0}\n.st-role{font-family:'Inter',sans-serif;font-size:.57rem;letter-spacing:.02em;line-height:1.55;color:var(--ink-soft);margin:.45rem 0 0}\n.st-urdu{font-family:'Lateef',serif;font-size:1.15rem;line-height:1.2;color:var(--oc);margin:0 0 .15rem}\n.st-nb{white-space:nowrap}\n\n/* masters named in a chain */\n.st-link .st-chip{background:transparent;color:var(--oc);border:1px solid var(--oc)}\n/* lineages / collective lines */\n.st-line{background:var(--st-card-alt);border-left-style:dashed;border-right-style:dashed;border-bottom-style:dashed}\n.st-line .st-chip{background:transparent;color:var(--oc);border:1px dashed var(--oc)}\n/* founders — filled in the order colour */\n.st-founder{background:var(--oc);border-color:var(--oc)}\n.st-founder .st-chip{background:color-mix(in srgb,var(--st-onc) 20%,transparent);color:var(--st-onc)}\n.st-founder .st-name,.st-founder .st-urdu{color:var(--st-onc)}\n.st-founder .st-sub,.st-founder .st-role{color:color-mix(in srgb,var(--st-onc) 78%,transparent)}\n/* the saints of this archive — gold */\n.st-saint{background:linear-gradient(180deg,var(--st-saint-a),var(--st-saint-b));border:1.5px solid var(--gold);border-top:3.5px solid var(--gold-deep);box-shadow:0 3px 12px rgba(160,112,32,.18)}\n.st-saint .st-name{color:var(--gold-deep);font-size:1.1rem}\n.st-saint .st-chip{background:var(--gold-deep);color:var(--st-onc)}\n.st-saint .st-sub{color:var(--st-saint-ink)}\n.st-saint .st-role{color:var(--st-saint-ink)}\n.st-star{position:absolute;top:-10px;left:50%;transform:translateX(-50%);width:20px;height:20px;line-height:19px;border-radius:50%;background:var(--gold-deep);color:var(--st-onc);font-size:.6rem;text-align:center}\n.st-goto{display:inline-block;margin-top:.55rem;font-family:'Inter',sans-serif;font-size:.53rem;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--gold-deep);border-bottom:1px solid var(--gold);padding-bottom:1px}\na.st-node{transition:transform .2s,box-shadow .2s}\na.st-node:hover{transform:translateY(-3px);box-shadow:0 8px 20px rgba(160,112,32,.28)}\na.st-node:focus-visible{outline:2px solid var(--gold);outline-offset:3px}\n/* the Prophet ﷺ */\n.st-prophet{background:var(--st-deep);border-color:var(--st-deep);border-top:3.5px solid var(--gold);width:250px;padding:1.05rem 1.2rem 1rem}\n.st-prophet .st-urdu{font-size:1.7rem;color:var(--gold-soft)}\n.st-prophet .st-name{color:var(--gold-soft);font-size:1.18rem}\n.st-prophet .st-sub{color:rgba(201,169,104,.78)}\n.st-prophet .st-role{color:rgba(250,247,239,.72)}\n/* the Companions */\n.st-comp{background:var(--cream)}\n.st-comp .st-chip{background:transparent;color:var(--gold-deep);border:1px solid var(--gold)}\n.st-comp .st-name{color:var(--gold-deep)}\n/* unnamed generations */\n.st-gap{width:auto;max-width:190px;background:transparent;border:1.5px dashed color-mix(in srgb,var(--oc,var(--gold)) 60%,transparent);border-radius:99px;padding:.4rem .9rem .45rem;box-shadow:none}\n.st-dots{display:block;font-size:.8rem;letter-spacing:.32em;color:var(--oc,var(--gold-deep));line-height:1}\n.st-glabel{display:block;font-family:'Inter',sans-serif;font-size:.5rem;letter-spacing:.09em;text-transform:uppercase;color:var(--ink-faint);line-height:1.5;margin-top:.25rem}\n/* condensed-origin capsule */\n.st-origin{display:flex;align-items:center;gap:.85rem;width:auto;background:var(--st-saint-a);border:1.5px dashed var(--gold);border-radius:99px;padding:.7rem 1.6rem;cursor:pointer;box-shadow:none;text-align:left}\n.st-origin:hover{background:var(--st-saint-b)}\n.st-origin .st-up{font-size:1rem;color:var(--gold-deep)}\n.st-origin .st-name{font-size:.98rem;color:var(--gold-deep);white-space:nowrap}\n.st-origin .st-sub{margin:0;white-space:nowrap;color:var(--st-saint-ink)}\n/* fold / unfold chip */\n.st-tg{position:absolute;bottom:-11px;left:50%;transform:translateX(-50%);z-index:3;min-width:22px;height:22px;padding:0 .4rem;border-radius:99px;border:1.5px solid var(--oc,var(--ink-faint));background:var(--st-card);color:var(--oc,var(--ink-faint));font-family:'Inter',sans-serif;font-size:.6rem;font-weight:600;line-height:19px;cursor:pointer;transition:background .16s,color .16s}\n.st-tg:hover{background:var(--oc);color:var(--st-onc)}\n.st-tg:focus-visible{outline:2px solid var(--gold);outline-offset:2px}\nli.st-closed>ul{display:none}\n\n/* ── key + hint below the frame ── */\n.st-key{display:flex;flex-wrap:wrap;gap:.4rem .9rem;justify-content:center;margin-top:.75rem}\n.st-lg{display:inline-flex;align-items:center;gap:.42rem;font-family:'Inter',sans-serif;font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-faint)}\n.st-dot{width:11px;height:11px;border-radius:50%;flex:none}\n.st-lg-saint .st-dot{background:linear-gradient(180deg,var(--st-saint-a),var(--st-saint-b));border:1.5px solid var(--gold-deep)}\n.st-lg-founder .st-dot{background:var(--ink-faint)}\n.st-lg-dash .st-dot{background:transparent;border:1.5px dashed var(--gold-deep)}\n.st-hint{font-family:'Inter',sans-serif;font-size:.58rem;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-faint);text-align:center;line-height:1.9;margin-top:.7rem}\n.st-hint kbd{font-family:'Inter',sans-serif;font-size:.55rem;border:1px solid var(--rule);border-radius:4px;padding:.1rem .3rem;color:var(--ink-soft)}\n\n@media (max-width:760px){\n  .st-frame{height:clamp(400px,68vh,640px)}\n  .st-rail-lab{width:100%;text-align:center;margin:0 0 .15rem}\n  .st-rail{justify-content:center;gap:.32rem}\n  .st-f{font-size:.55rem;padding:.36rem .66rem}\n  .st-tree{padding:3.6rem 1.1rem 4.4rem}\n  .st-ctl-tl{left:.5rem;top:.5rem;right:.5rem}\n  .st-pill{font-size:.53rem;padding:.44rem .7rem;width:100%;justify-content:center}\n  .st-ctl-br{right:.5rem;bottom:.5rem;left:.5rem;justify-content:center}\n  .st-sq{width:30px;height:30px}\n  .st-zlab{min-width:2.7rem}\n  .st-keys{display:none}\n}\n@media (prefers-reduced-motion:reduce){\n  a.st-node,.st-sq,.st-f,.st-tg{transition:none}\n  a.st-node:hover{transform:none}\n}\n</style>\n\n<div class=\"pillars-strip\">\n  <span class=\"pillars-strip-label\">The Shajara</span>\n  <a href=\"#chains\">The Chains</a><span class=\"pillars-strip-sep\">◆</span><a href=\"#tree\">The Tree</a><span class=\"pillars-strip-sep\">◆</span><a href=\"#notes\">Reading the Tree</a>\n</div>\n\n<section class=\"section-wrap narrow\" id=\"chains\">\n  <span class=\"sec-label\">I · The Chains</span>\n  <h2 class=\"sec-title\">Seven saints, one <em style=\"color:var(--gold-deep);font-style:italic;\">tree</em></h2>\n  <p class=\"section-intro\">Every saint recorded in this archive stood inside a chain of masters — and every chain ascends to the same root.</p>\n  <div class=\"prose\">\n    <p>A Sufi's authority is documentary. Each of the seven saints whose lives this archive records held a formal place in a <em>silsila</em> — a chain of teachers in which each master licensed his successor by <em>khilafat</em>, link by link, back through the founder of the order and the generations before him to the Companions of the Prophet ﷺ and to the Prophet ﷺ himself. To ask \"who was this saint's master?\" is therefore always answerable, and the answers connect: Burhanuddin Gharib and Bandanawaz Gisudaraz meet two links apart in the hospice of Nizamuddin Awliya; Shah Raju Qattal and the Yousufain brothers stand on one Qadiri stem; and all of the chains, followed far enough upward, converge.</p>\n    <p>The chart below assembles those chains — exactly as each saint's own record on this site documents them — into a single tree, or <em>shajara</em>. The <strong style=\"color:var(--gold-deep);\">gold cards</strong> are the seven saints of this archive; selecting one opens his full record. The filled, coloured cards are the founders of the four classical silsilas of the Deccan — Chishti, Qadiri, Suhrawardi and Naqshbandi — with a fifth, slate-coloured line for the Hamadani family descent of Hussain Shah Wali. Dashed connectors mark links the records document but do not name, or descent by family rather than formal khilafat.</p>\n    <p>Five chains at once make a wide chart. Use the row of chips above the chart to read one silsila at a time; the zoom, fit and full-screen controls sit in the corners of the chart itself.</p>\n  </div>\n</section>\n\n<hr class=\"h-rule\"/>\n\n<section class=\"section-wrap\" id=\"tree\">\n  <span class=\"sec-label\">II · The Tree</span>\n  <h2 class=\"sec-title\">From the Prophet ﷺ to the <em style=\"color:var(--gold-deep);font-style:italic;\">Deccan</em></h2>\n  <p class=\"section-intro\">The tree opens at the founders of the orders. Use the button in the top-left of the chart to reveal the earlier generations, up to the Companions and the Prophet ﷺ.</p>\n\n  <div class=\"st-app\" id=\"st-app\">\n    <div class=\"st-rail\" role=\"group\" aria-label=\"Show one silsila at a time\">\n      <span class=\"st-rail-lab\">Chain</span>\n      <button type=\"button\" class=\"st-f\" data-b=\"all\" aria-pressed=\"true\">All five</button>\n      <button type=\"button\" class=\"st-f\" data-b=\"chishti\" style=\"--c:var(--st-chishti)\" aria-pressed=\"false\"><i></i>Chishti</button>\n      <button type=\"button\" class=\"st-f\" data-b=\"qadiri\" style=\"--c:var(--st-qadiri)\" aria-pressed=\"false\"><i></i>Qadiri</button>\n      <button type=\"button\" class=\"st-f\" data-b=\"suhrawardi\" style=\"--c:var(--st-suhrawardi)\" aria-pressed=\"false\"><i></i>Suhrawardi</button>\n      <button type=\"button\" class=\"st-f\" data-b=\"naqshbandi\" style=\"--c:var(--st-naqshbandi)\" aria-pressed=\"false\"><i></i>Naqshbandi</button>\n      <button type=\"button\" class=\"st-f\" data-b=\"hamadani\" style=\"--c:var(--st-hamadani)\" aria-pressed=\"false\"><i></i>Hamadani</button>\n    </div>\n\n    <div class=\"st-frame\" id=\"st-frame\">\n      <div class=\"st-viewport\" id=\"st-viewport\" tabindex=\"0\" role=\"group\" aria-label=\"Silsila tree. Drag to pan; use the zoom controls, or the plus, minus and zero keys.\">\n        <div class=\"st-canvas\" id=\"st-canvas\">\n          <div class=\"st-tree\" id=\"st-tree\"></div>\n        </div>\n      </div>\n\n      <div class=\"st-ctl st-ctl-tl\">\n        <button type=\"button\" id=\"st-up\" class=\"st-pill\" aria-expanded=\"false\">⌃&nbsp; Show the chain to the Prophet ﷺ</button>\n      </div>\n\n      <div class=\"st-ctl st-ctl-br\">\n        <button type=\"button\" id=\"st-zout\" class=\"st-sq\" aria-label=\"Zoom out\" title=\"Zoom out (−)\">−</button>\n        <span class=\"st-zlab\" id=\"st-zlab\" aria-live=\"polite\" aria-label=\"Current zoom\">100%</span>\n        <button type=\"button\" id=\"st-zin\" class=\"st-sq\" aria-label=\"Zoom in\" title=\"Zoom in (+)\">+</button>\n        <span class=\"st-sep\" aria-hidden=\"true\"></span>\n        <button type=\"button\" id=\"st-fit\" class=\"st-sq st-sq-txt\" title=\"Fit the whole chain in view (0)\">Fit</button>\n        <span class=\"st-sep\" aria-hidden=\"true\"></span>\n        <button type=\"button\" id=\"st-full\" class=\"st-sq\" aria-pressed=\"false\" aria-label=\"Enter full screen\" title=\"Full screen (F)\">⛶</button>\n      </div>\n    </div>\n\n    <div class=\"st-key\" aria-label=\"Key\">\n      <span class=\"st-lg st-lg-saint\"><span class=\"st-dot\"></span>✦ Saint of this archive — opens his record</span>\n      <span class=\"st-lg st-lg-founder\"><span class=\"st-dot\"></span>Founder of a silsila</span>\n      <span class=\"st-lg st-lg-dash\"><span class=\"st-dot\"></span>Documented but unnamed links · family descent</span>\n    </div>\n\n    <p class=\"st-hint\">Drag the chart to travel across it · the circle beneath a card folds or unfolds its successors<span class=\"st-keys\"> · <kbd>+</kbd> <kbd>−</kbd> zoom, <kbd>0</kbd> fit, <kbd>F</kbd> full screen, <kbd>Esc</kbd> to leave it</span></p>\n  </div>\n\n  <noscript>\n    <div class=\"prose\" style=\"margin-top:2rem;\">\n      <p><strong>The chains, in brief</strong> (the interactive tree needs JavaScript):</p>\n      <p><em>Chishti</em> — Khwaja Mu'inuddin Chishti of Ajmer → Qutbuddin Bakhtiyar Kaki → Baba Farid of Pakpattan → Nizamuddin Awliya → <a href=\"/sufism/burhanuddin/\">Burhanuddin Gharib</a> of Khuldabad, whose successors were Zayn al-Din Shirazi and Rukn al-Din Dabir al-Mulk; and Nizamuddin Awliya → Nasir al-Din Chiragh-i-Delhi → <a href=\"/sufism/bandanawaz/\">Bandanawaz Gisudaraz</a> of Gulbarga, whose disciple Sayyid Muhammad Akbar Husayni compiled his discourses.</p>\n      <p><em>Qadiri</em> — Shaykh 'Abd al-Qadir Jilani of Baghdad → (documented chain) → Sayyid Yusuf al-Husayni of Bidar → <a href=\"/sufism/shah-raju/\">Shah Raju Qattal</a> of Hyderabad, whose own Husayni Sayyid ancestry runs through Sayyid Hamza → his descendants, the <a href=\"/sufism/yousufain/\">Yousufain brothers</a> and the Mahbub Subhani line.</p>\n      <p><em>Suhrawardi</em> — Shaykh Shihab al-Din 'Umar al-Suhrawardi of Baghdad → Baha al-Din Zakariya of Multan → (documented chain) → <a href=\"/sufism/sharfuddin/\">Baba Sharfuddin</a> of Pahadi Sharif.</p>\n      <p><em>Hamadani line</em> — the family of Sayyid 'Ali al-Hamadhani of Kashmir → <a href=\"/sufism/hussain-shah-wali/\">Hussain Shah Wali</a> of Hyderabad.</p>\n      <p><em>Naqshbandi</em> — Khwaja Baha al-Din Naqshband of Bukhara → (brought south by Mughal-era scholars) → Khwaja Habibullah Naqshbandi → the Naqshbandi-Qadiri line of Hyderabad → <a href=\"/sufism/shah-khamosh/\">Shah Khamosh</a>.</p>\n    </div>\n  </noscript>\n</section>\n\n<section class=\"note-card\" id=\"notes\" aria-label=\"A note on reading the tree\">\n  <span class=\"note-card-label\">Reading the Tree</span>\n  <p class=\"note-card-body\">This shajara is drawn strictly from the seven saint records of this archive and the Sufism index page; it introduces no names or dates beyond them. A solid line is a master-to-disciple (or master-to-khalifa) relation named in the records — comparable, as the index page notes, to a hadith chain of transmission (<em>isnad</em>). A dashed line marks either links the records document but do not name — as between 'Abd al-Qadir Jilani and Sayyid Yusuf al-Husayni of Bidar, or in the Multan chain above Baba Sharfuddin — or descent by family rather than formal khilafat, as with the Yousufain brothers from Shah Raju Qattal and Hussain Shah Wali from the family of 'Ali al-Hamadhani. Shah Raju Qattal's record documents two separate threads back to Baghdad, and the tree shows both: his initiatic chain, which passes through Sayyid Yusuf al-Husayni of Bidar and forms his line of descent in the chart, and his Husayni Sayyid ancestry, which runs through Sayyid Hamza, the spiritual brother of Sayyid Muhammad Gisudaraz, and is drawn as a separate dashed arrow into his card. The records do not place these two threads in any order relative to one another, so the tree does not either. Shah Khamosh belonged to the combined Naqshbandi-Qadiri silsila characteristic of early Asaf Jahi Hyderabad; the tree places him on the Naqshbandi stem, which by the classical reckoning ascends through Abu Bakr al-Siddiq, while the other chains ascend through 'Ali ibn Abi Talib. The generations between the Companions and the founders of the orders are shown condensed.</p>\n</section>\n\n<script>\n(function(){\n  \"use strict\";\n\n  /* ══ the tree, drawn from the saint records of this site ══ */\n\n  /* — Qadiri — */\n  var yousuf = {k:\"saint\", b:\"qadiri\", dash:true, chip:\"Qadiri · Descendant\", name:\"Shah Yousuf-uddin Husayni\", sub:\"Nampally, Hyderabad · c. 1668–1741\", role:\"The elder of the Yousufain — teacher of hadith at Hyderabad\", url:\"/sufism/yousufain/\"};\n  var sharif = {k:\"saint\", b:\"qadiri\", dash:true, chip:\"Qadiri · Descendant\", name:\"Shah Sharif-uddin Husayni\", sub:\"Nampally, Hyderabad · 18th c.\", role:\"The younger of the Yousufain — principal khalifa of the family\", url:\"/sufism/yousufain/\"};\n  var mahbub = {k:\"line\", b:\"qadiri\", dash:true, chip:\"Lineage\", name:\"The Mahbub Subhani line\", sub:\"Later Asaf Jahi period\", role:\"Qadiri family line descended from Shah Raju\"};\n  var shahraju = {k:\"saint\", b:\"qadiri\", a:\"shahraju\", chip:\"Qadiri\", name:\"Shah Raju Qattal Qadiri\", sub:\"Bidar → Misri Gunj, Hyderabad · d. c. 1632\", role:\"Founder of the Qadiri silsila at Hyderabad\", url:\"/sufism/shah-raju/\", kids:[yousuf, sharif, mahbub]};\n  var yusufBidar = {k:\"link\", b:\"qadiri\", dash:true, chip:\"Initiatic chain\", name:\"Sayyid Yusuf al-Husayni\", sub:\"Bidar\", role:\"The named link through which Shah Raju received Qadiri initiation\", kids:[shahraju]};\n  var hamza = {k:\"line\", b:\"qadiri\", dash:true, a:\"hamza\", chip:\"Family descent\", name:\"Sayyid Hamza\", sub:\"Spiritual brother of Sayyid Muhammad Gisudaraz\", role:\"Shah Raju's Husayni Sayyid ancestry traces to the Qadiri masters of Baghdad through him\"};\n\n  /* Shah Raju's record documents two threads back to Baghdad. The initiatic\n     one is his line of descent in the tree; the family one cannot also be a\n     parent edge in a single-parent chart, so it is drawn across as a link. */\n  var XLINKS = [{from:\"hamza\", to:\"shahraju\", label:\"family descent\"}];\n  var gapQ = {k:\"gap\", b:\"qadiri\", dash:true, name:\"Unnamed links of the documented chain\", kids:[hamza, yusufBidar]};\n  var jilani = {k:\"founder\", b:\"qadiri\", dash:true, chip:\"Qadiriyya · Founder\", urdu:\"قادریہ\", name:\"Shaykh 'Abd al-Qadir Jilani\", sub:\"Baghdad · d. 1166\", role:\"Master of the Qadiri silsila\", kids:[gapQ]};\n\n  /* — Suhrawardi — */\n  var sharfuddin = {k:\"saint\", b:\"suhrawardi\", dash:true, chip:\"Suhrawardi\", name:\"Baba Sharfuddin\", sub:\"Pahadi Sharif, Hyderabad · late 15th c.\", role:\"The Suhrawardi saint of the hill — Pahadi Wale Baba\", url:\"/sufism/sharfuddin/\"};\n  var gapS = {k:\"gap\", b:\"suhrawardi\", dash:true, name:\"Unnamed masters of the Multan chain\", kids:[sharfuddin]};\n  var zakariya = {k:\"link\", b:\"suhrawardi\", chip:\"Khalifa\", name:\"Baha al-Din Zakariya\", sub:\"Multan\", role:\"The great khalifa who carried the order into the subcontinent\", kids:[gapS]};\n  var suhrawardi = {k:\"founder\", b:\"suhrawardi\", dash:true, chip:\"Suhrawardiyya · Founder\", urdu:\"سہروردیہ\", name:\"Shihab al-Din 'Umar al-Suhrawardi\", sub:\"Baghdad · d. 1234\", role:\"Master of the Suhrawardi silsila\", kids:[zakariya]};\n\n  /* — Chishti — */\n  var zayn = {k:\"link\", b:\"chishti\", chip:\"Khalifa · Successor\", name:\"Zayn al-Din Shirazi\", sub:\"Khuldabad · d. 1369\", role:\"Burhanuddin's principal successor at the Khuldabad hospice\"};\n  var rukn = {k:\"link\", b:\"chishti\", chip:\"Disciple\", name:\"Rukn al-Din Dabir al-Mulk\", sub:\"Khuldabad\", role:\"Compiler of the Nafa'is al-Anfas, the hospice's discourses\"};\n  var burhanuddin = {k:\"saint\", b:\"chishti\", chip:\"Chishti\", name:\"Burhanuddin Gharib\", sub:\"Hansi → Khuldabad · d. 1337\", role:\"First Chishti shaykh of the Deccan — founder of the Khuldabad hospice\", url:\"/sufism/burhanuddin/\", kids:[zayn, rukn]};\n  var akbar = {k:\"link\", b:\"chishti\", chip:\"Disciple\", name:\"Sayyid Muhammad Akbar Husayni\", sub:\"Gulbarga\", role:\"Compiler of the Javami' al-Kalim\"};\n  var bandanawaz = {k:\"saint\", b:\"chishti\", chip:\"Chishti\", name:\"Bandanawaz Gisudaraz\", sub:\"Delhi → Gulbarga · 1321–1422\", role:\"The most learned Sufi of the medieval Deccan\", url:\"/sufism/bandanawaz/\", kids:[akbar]};\n  var chiragh = {k:\"link\", b:\"chishti\", chip:\"Khalifa\", name:\"Nasir al-Din Chiragh-i-Delhi\", sub:\"Delhi · d. 1356\", role:\"Chief successor of Nizamuddin Awliya — the last great Chishti of the north\", kids:[bandanawaz]};\n  var nizamuddin = {k:\"link\", b:\"chishti\", chip:\"Khalifa\", name:\"Khwaja Nizamuddin Awliya\", sub:\"Delhi · d. 1325\", role:\"The great Chishti master of the Delhi Sultanate — his khalifas carried the order to the Deccan\", kids:[burhanuddin, chiragh]};\n  var farid = {k:\"link\", b:\"chishti\", chip:\"Khalifa\", name:\"Baba Farid\", sub:\"Pakpattan\", role:\"Master of Nizamuddin Awliya\", kids:[nizamuddin]};\n  var kaki = {k:\"link\", b:\"chishti\", chip:\"Khalifa\", name:\"Qutbuddin Bakhtiyar Kaki\", sub:\"Delhi\", role:\"Successor of Mu'inuddin in the Indian Chishti chain\", kids:[farid]};\n  var moinuddin = {k:\"founder\", b:\"chishti\", dash:true, chip:\"Chishtiyya · Founder\", urdu:\"چشتیہ\", name:\"Khwaja Mu'inuddin Chishti\", sub:\"Ajmer · d. 1236\", role:\"Master of the Chishti silsila in India\", kids:[kaki]};\n\n  /* — Hamadani family line — */\n  var hussain = {k:\"saint\", b:\"hamadani\", dash:true, chip:\"Hamadani line\", name:\"Hussain Shah Wali\", sub:\"Golconda → Hyderabad · d. 1599\", role:\"Scholar-engineer of the Hussain Sagar (1562)\", url:\"/sufism/hussain-shah-wali/\"};\n  var gapH = {k:\"gap\", b:\"hamadani\", dash:true, name:\"Kashmiri Sayyid family · generations\", kids:[hussain]};\n  var hamadani = {k:\"founder\", b:\"hamadani\", dash:true, chip:\"Hamadani line\", name:\"Sayyid 'Ali al-Hamadhani\", sub:\"Kashmir\", role:\"The Sufi master whose family line reached the Deccan\", kids:[gapH]};\n\n  /* — Naqshbandi — */\n  var khamosh = {k:\"saint\", b:\"naqshbandi\", dash:true, chip:\"Naqshbandi-Qadiri\", name:\"Shah Khamosh\", sub:\"Old City, Hyderabad · d. 1740\", role:\"The silent saint — counsellor to Asaf Jah I\", url:\"/sufism/shah-khamosh/\"};\n  var nqline = {k:\"line\", b:\"naqshbandi\", dash:true, chip:\"Combined line\", name:\"The Naqshbandi-Qadiri line of Hyderabad\", sub:\"17th–18th c.\", role:\"The Hyderabad Naqshbandi chain joined with the Qadiri — the path Shah Khamosh received\", kids:[khamosh]};\n  var habibullah = {k:\"link\", b:\"naqshbandi\", dash:true, chip:\"In the chain\", name:\"Khwaja Habibullah Naqshbandi\", sub:\"Hyderabad · 17th–18th c.\", role:\"The named master through whom, with others, the order was established at Hyderabad\", kids:[nqline]};\n  var gapN = {k:\"gap\", b:\"naqshbandi\", dash:true, name:\"Carried south by Mughal-era scholars\", kids:[habibullah]};\n  var naqshband = {k:\"founder\", b:\"naqshbandi\", dash:true, chip:\"Naqshbandiyya · Founder\", urdu:\"نقشبندیہ\", name:\"Khwaja Baha al-Din Naqshband\", sub:\"Bukhara · d. 1389\", role:\"Master of the Naqshbandi silsila\", kids:[gapN]};\n\n  var FOUNDERS = {chishti:moinuddin, qadiri:jilani, suhrawardi:suhrawardi, naqshbandi:naqshband, hamadani:hamadani};\n  var ORDER = [\"chishti\",\"qadiri\",\"suhrawardi\",\"naqshbandi\",\"hamadani\"];\n  var ALI_CHAINS = [\"chishti\",\"qadiri\",\"suhrawardi\",\"hamadani\"];\n\n  var LABEL = {chishti:\"Chishti\", qadiri:\"Qadiri\", suhrawardi:\"Suhrawardi\", naqshbandi:\"Naqshbandi\", hamadani:\"Hamadani\"};\n  function gapTo(b, node){\n    return {k:\"gap\", b:b, dash:true, name:\"Generations of the \" + LABEL[b] + \" chain\", kids:[node]};\n  }\n\n  /* roots are rebuilt per filter so that one chain can be read on its own */\n  function condensedRoot(filter){\n    var kids = ORDER.filter(function(b){ return filter === \"all\" || filter === b; })\n                    .map(function(b){ return FOUNDERS[b]; });\n    if(kids.length === 1){ return kids[0]; }\n    return {k:\"origin\", b:\"root\", name:\"The chains continue upward\",\n            sub:\"through the Companions to the Prophet ﷺ — show the earlier generations\", kids:kids};\n  }\n\n  function fullRoot(filter){\n    var aliKids = ALI_CHAINS.filter(function(b){ return filter === \"all\" || filter === b; })\n                            .map(function(b){ return gapTo(b, FOUNDERS[b]); });\n    var comps = [];\n    if(aliKids.length){\n      comps.push({k:\"comp\", b:\"root\", chip:\"Companion\", name:\"'Ali ibn Abi Talib\",\n        role:\"Fountainhead of the Chishti, Qadiri, Suhrawardi and Hamadani chains\", kids:aliKids});\n    }\n    if(filter === \"all\" || filter === \"naqshbandi\"){\n      comps.push({k:\"comp\", b:\"root\", chip:\"Companion\", name:\"Abu Bakr al-Siddiq\",\n        role:\"Fountainhead of the Naqshbandi chain\", kids:[gapTo(\"naqshbandi\", naqshband)]});\n    }\n    return {k:\"prophet\", b:\"root\", urdu:\"مُحَمَّد رَسُولُ الله ﷺ\", name:\"The Prophet Muhammad ﷺ\",\n            sub:\"Madina · d. 632 CE\", role:\"Every silsila of Tasawwuf begins its chain with him\", kids:comps};\n  }\n\n  /* ══ rendering ══ */\n\n  var app      = document.getElementById(\"st-app\");\n  var frame    = document.getElementById(\"st-frame\");\n  var treeEl   = document.getElementById(\"st-tree\");\n  var canvas   = document.getElementById(\"st-canvas\");\n  var viewport = document.getElementById(\"st-viewport\");\n  var upBtn    = document.getElementById(\"st-up\");\n  var fullBtn  = document.getElementById(\"st-full\");\n  var zlab     = document.getElementById(\"st-zlab\");\n\n  var MIN_Z = 0.3, MAX_Z = 1.6;\n  var toProphet = false;   /* is the chain above the founders shown? */\n  var filter = \"all\";\n  var z = 1;\n  var isFull = false;\n  var scrollY = 0;\n\n  /* apostrophes are everywhere in these names and the markup below is built\n     with single-quoted attributes, so quotes have to be escaped too */\n  function esc(s){\n    return String(s).replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\")\n                    .replace(/\"/g,\"&quot;\").replace(/'/g,\"&#39;\");\n  }\n\n  /* names such as \"Shah Yousuf-uddin Husayni\" or \"Nasir al-Din Chiragh-i-Delhi\"\n     must not be split at their hyphens, so those become non-breaking hyphens */\n  function name(s){ return esc(s).replace(/(\\S)-(\\S)/g, \"$1\\u2011$2\"); }\n\n  function cardHtml(n){\n    var h = \"\";\n    if(n.k === \"gap\"){\n      return \"<div class='st-node st-gap'><span class='st-dots'>· · ·</span>\" +\n             \"<span class='st-glabel'>\" + esc(n.name) + \"</span></div>\";\n    }\n    if(n.k === \"origin\"){\n      return \"<button type='button' class='st-node st-origin' id='st-origin-node'>\" +\n             \"<span class='st-up'>⌃</span><span><span class='st-name'>\" + name(n.name) + \"</span>\" +\n             \"<p class='st-sub'>\" + esc(n.sub) + \"</p></span></button>\";\n    }\n    if(n.k === \"saint\"){ h += \"<span class='st-star' aria-hidden='true'>✦</span>\"; }\n    if(n.chip){ h += \"<span class='st-chip'>\" + esc(n.chip) + \"</span>\"; }\n    if(n.urdu){ h += \"<div class='st-urdu' dir='rtl'>\" + n.urdu + \"</div>\"; }\n    h += \"<h4 class='st-name'>\" + name(n.name) + \"</h4>\";\n    if(n.sub){ h += \"<p class='st-sub'>\" + esc(n.sub) + \"</p>\"; }\n    if(n.role){ h += \"<p class='st-role'>\" + esc(n.role) + \"</p>\"; }\n    if(n.url){ h += \"<span class='st-goto'>Read the record</span>\"; }\n    var cls = \"st-node st-\" + n.k;\n    var at = n.a ? \" data-a='\" + n.a + \"'\" : \"\";\n    if(n.url){ return \"<a class='\" + cls + \"' href='\" + n.url + \"'\" + at + \">\" + h + \"</a>\"; }\n    return \"<div class='\" + cls + \"'\" + at + \">\" + h + \"</div>\";\n  }\n\n  function countBelow(n){\n    var c = 0;\n    (n.kids || []).forEach(function(kid){\n      if(kid.k !== \"gap\"){ c += 1; }\n      c += countBelow(kid);\n    });\n    return c;\n  }\n\n  function liHtml(n){\n    var cls = \"st-b-\" + (n.b || \"root\") + (n.dash ? \" st-dash\" : \"\");\n    var h = \"<li class='\" + cls + \"'><div class='st-cardwrap'>\" + cardHtml(n);\n    var kids = n.kids || [];\n    var foldable = kids.length && n.k !== \"gap\" && n.k !== \"origin\" && n.k !== \"prophet\" && n.k !== \"comp\";\n    if(foldable){\n      h += \"<button type='button' class='st-tg' data-count='\" + countBelow(n) +\n           \"' aria-expanded='true' aria-label='Fold or unfold the successors of \" + esc(n.name) + \"'>−</button>\";\n    }\n    h += \"</div>\";\n    if(kids.length){\n      var allDash = kids.every(function(kid){ return kid.dash; });\n      h += \"<ul\" + (allDash ? \" class='st-dashkids'\" : \"\") + \">\" + kids.map(liHtml).join(\"\") + \"</ul>\";\n    }\n    return h + \"</li>\";\n  }\n\n  /* ══ zoom / pan ══ */\n\n  /* draw the cross-links, in the tree's own unscaled coordinates, whenever\n     the chart is re-laid-out (render, fold, zoom, resize) */\n  function drawXlinks(){\n    var svg = treeEl.querySelector(\".st-xlink\");\n    if(!svg){ return; }\n    var w = treeEl.offsetWidth, hh = treeEl.offsetHeight;\n    svg.setAttribute(\"width\", w);\n    svg.setAttribute(\"height\", hh);\n    svg.setAttribute(\"viewBox\", \"0 0 \" + w + \" \" + hh);\n    var tr = treeEl.getBoundingClientRect();\n    var out = \"\";\n    XLINKS.forEach(function(lk){\n      var a = treeEl.querySelector(\"[data-a='\" + lk.from + \"']\");\n      var c = treeEl.querySelector(\"[data-a='\" + lk.to + \"']\");\n      if(!a || !c || a.offsetParent === null || c.offsetParent === null){ return; }\n      var ra = a.getBoundingClientRect(), rc = c.getBoundingClientRect();\n      var x1 = (ra.left + ra.width / 2 - tr.left) / z;\n      var y1 = (ra.bottom - tr.top) / z;\n      var x2 = (rc.left - tr.left) / z - 9;\n      var y2 = (rc.top + rc.height / 2 - tr.top) / z;\n      if(x2 <= x1 + 24 || y2 <= y1 + 24){ return; }\n      var r = 12;\n      out += \"<path d='M\" + x1 + \",\" + y1 + \" V\" + (y2 - r) +\n             \" Q\" + x1 + \",\" + y2 + \" \" + (x1 + r) + \",\" + y2 +\n             \" H\" + x2 + \"' marker-end='url(#st-arrow)'></path>\";\n      out += \"<text x='\" + (x1 + r + 6) + \"' y='\" + (y2 - 6) + \"'>\" + lk.label + \"</text>\";\n    });\n    svg.innerHTML =\n      \"<defs><marker id='st-arrow' viewBox='0 0 8 8' refX='7' refY='4' markerWidth='6' \" +\n      \"markerHeight='6' orient='auto'><path d='M0,0 L8,4 L0,8 z' fill='var(--st-qadiri)' \" +\n      \"stroke='none'></path></marker></defs>\" + out;\n  }\n\n  function layout(){\n    treeEl.style.transform = \"scale(\" + z + \")\";\n    var w = Math.round(treeEl.offsetWidth * z);\n    var hh = Math.round(treeEl.offsetHeight * z);\n    canvas.style.width  = w + \"px\";\n    canvas.style.height = hh + \"px\";\n    /* a short chart sits in the middle of the frame rather than leaving a\n       block of dead space beneath it */\n    var slack = viewport.clientHeight - hh;\n    canvas.style.marginTop = (slack > 0 ? Math.round(slack / 2) : 0) + \"px\";\n    zlab.textContent = Math.round(z * 100) + \"%\";\n    drawXlinks();\n  }\n\n  function centerX(){\n    viewport.scrollLeft = Math.max(0, (canvas.offsetWidth - viewport.clientWidth) / 2);\n  }\n\n  /* fit the chain across the width of the view and never past 1:1 — a long\n     chain is meant to be scrolled down, not shrunk until it cannot be read */\n  function fit(floor){\n    var w = treeEl.offsetWidth;\n    if(!w){ return; }\n    z = Math.max(MIN_Z, Math.min(1, (viewport.clientWidth - 8) / w));\n    /* the opening view passes a floor: on a narrow screen a whole-tree fit\n       lands somewhere near 30%, which is a blur rather than a chart */\n    if(floor){ z = Math.max(z, floor); }\n    layout();\n    centerX();\n    viewport.scrollTop = 0;\n  }\n  var OPEN_FLOOR = 0.5;\n\n  function setZoom(nz, ax, ay){\n    nz = Math.max(MIN_Z, Math.min(MAX_Z, nz));\n    if(nz === z){ return; }\n    /* keep the given viewport point (defaults to the centre) fixed */\n    var px = (ax === undefined ? viewport.clientWidth  / 2 : ax);\n    var py = (ay === undefined ? viewport.clientHeight / 2 : ay);\n    var tx = (viewport.scrollLeft + px) / z;\n    var ty = (viewport.scrollTop  + py) / z;\n    z = nz;\n    layout();\n    viewport.scrollLeft = tx * z - px;\n    viewport.scrollTop  = ty * z - py;\n  }\n\n  function step(dir){ setZoom(z * (dir > 0 ? 1.18 : 1 / 1.18)); }\n\n  /* ══ full screen ══ */\n\n  function setFull(on){\n    if(on === isFull){ return; }\n    isFull = on;\n    if(on){\n      scrollY = window.scrollY;\n      app.classList.add(\"is-full\");\n      document.body.classList.add(\"st-locked\");\n    }else{\n      app.classList.remove(\"is-full\");\n      document.body.classList.remove(\"st-locked\");\n      window.scrollTo(0, scrollY);\n    }\n    fullBtn.setAttribute(\"aria-pressed\", on ? \"true\" : \"false\");\n    fullBtn.setAttribute(\"aria-label\", on ? \"Leave full screen\" : \"Enter full screen\");\n    fullBtn.setAttribute(\"title\", on ? \"Leave full screen (Esc)\" : \"Full screen (F)\");\n    fullBtn.textContent = on ? \"✕\" : \"⛶\";\n    requestAnimationFrame(function(){ fit(OPEN_FLOOR); });\n  }\n\n  /* ══ render ══ */\n\n  function render(keepZoom){\n    var root = toProphet ? fullRoot(filter) : condensedRoot(filter);\n    treeEl.innerHTML = \"<svg class='st-xlink' aria-hidden='true'></svg><ul>\" + liHtml(root) + \"</ul>\";\n    upBtn.innerHTML = toProphet\n      ? \"⌄&nbsp; Condense the earlier generations\"\n      : \"⌃&nbsp; Show the chain to the Prophet ﷺ\";\n    upBtn.setAttribute(\"aria-expanded\", toProphet ? \"true\" : \"false\");\n    if(keepZoom){ layout(); centerX(); } else { fit(OPEN_FLOOR); }\n  }\n\n  /* ══ events ══ */\n\n  treeEl.addEventListener(\"click\", function(e){\n    var tg = e.target.closest(\".st-tg\");\n    if(tg){\n      var li = tg.closest(\"li\");\n      var closed = li.classList.toggle(\"st-closed\");\n      tg.textContent = closed ? \"+\" + tg.getAttribute(\"data-count\") : \"−\";\n      tg.setAttribute(\"aria-expanded\", closed ? \"false\" : \"true\");\n      layout();\n      return;\n    }\n    if(e.target.closest(\"#st-origin-node\")){\n      toProphet = true;\n      render();\n    }\n  });\n\n  upBtn.addEventListener(\"click\", function(){ toProphet = !toProphet; render(); });\n  fullBtn.addEventListener(\"click\", function(){ setFull(!isFull); });\n  document.getElementById(\"st-zin\").addEventListener(\"click\", function(){ step(1); });\n  document.getElementById(\"st-zout\").addEventListener(\"click\", function(){ step(-1); });\n  document.getElementById(\"st-fit\").addEventListener(\"click\", function(){ fit(); });\n\n  Array.prototype.forEach.call(app.querySelectorAll(\".st-f\"), function(btn){\n    btn.addEventListener(\"click\", function(){\n      filter = btn.getAttribute(\"data-b\");\n      Array.prototype.forEach.call(app.querySelectorAll(\".st-f\"), function(b){\n        b.setAttribute(\"aria-pressed\", b === btn ? \"true\" : \"false\");\n      });\n      render();\n    });\n  });\n\n  window.addEventListener(\"resize\", function(){ layout(); });\n\n  /* ctrl/⌘ + wheel zooms; a plain wheel keeps its normal scrolling */\n  viewport.addEventListener(\"wheel\", function(e){\n    if(!(e.ctrlKey || e.metaKey)){ return; }\n    e.preventDefault();\n    var r = viewport.getBoundingClientRect();\n    setZoom(z * (e.deltaY < 0 ? 1.1 : 1 / 1.1), e.clientX - r.left, e.clientY - r.top);\n  }, {passive:false});\n\n  /* drag to pan */\n  var drag = null;\n  viewport.addEventListener(\"pointerdown\", function(e){\n    if(e.button !== 0 || e.target.closest(\"a, button\")){ return; }\n    drag = {x:e.clientX, y:e.clientY, sl:viewport.scrollLeft, st:viewport.scrollTop};\n    viewport.classList.add(\"is-grabbing\");\n  });\n  window.addEventListener(\"pointermove\", function(e){\n    if(!drag){ return; }\n    viewport.scrollLeft = drag.sl - (e.clientX - drag.x);\n    viewport.scrollTop  = drag.st - (e.clientY - drag.y);\n  });\n  function endDrag(){ drag = null; viewport.classList.remove(\"is-grabbing\"); }\n  window.addEventListener(\"pointerup\", endDrag);\n  window.addEventListener(\"pointercancel\", endDrag);\n\n  /* keyboard */\n  document.addEventListener(\"keydown\", function(e){\n    if(e.key === \"Escape\" && isFull){ setFull(false); return; }\n    if(e.ctrlKey || e.metaKey || e.altKey){ return; }\n    var inside = isFull || app.contains(document.activeElement);\n    if(!inside){ return; }\n    var t = e.target;\n    if(t && (t.tagName === \"INPUT\" || t.tagName === \"TEXTAREA\" || t.isContentEditable)){ return; }\n    if(e.key === \"+\" || e.key === \"=\"){ e.preventDefault(); step(1); }\n    else if(e.key === \"-\" || e.key === \"_\"){ e.preventDefault(); step(-1); }\n    else if(e.key === \"0\"){ e.preventDefault(); fit(); }\n    else if(e.key === \"f\" || e.key === \"F\"){ e.preventDefault(); setFull(!isFull); }\n  });\n\n  render();\n\n  /* the web fonts change card metrics; re-fit once they have settled */\n  if(document.fonts && document.fonts.ready){ document.fonts.ready.then(function(){ fit(OPEN_FLOOR); }); }\n})();\n</script>"
    }
